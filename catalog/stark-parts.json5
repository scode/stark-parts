  products: [
    {
      code: "titanium-footpegs-pair-road-legal",
      display_name: "Titanium footpegs pair (Road-legal)",
      localization_key: "spare_parts_product_titanium-footpegs-pair-road-legal_name",
      stark_url: "https://starkfuture.com/parts-and-accessories/product/titanium-footpegs-pair-road-legal",
      image_urls: ["https://assets.starkfuture.com/spare-parts-images/SEX1_Titanium_Titanium_footpegs.webp"],
      articles: [
        {
          code: "titanium-footpegs-pair-road-legal",
          display_name: "Titanium footpegs pair (Road-legal)",
          description: "Pair of street-legal titanium footpegs for Stark VARG EX and SM.\nSaves 200 g versus the standard steel footpeg without compromising strength.\nSlightly rounded profile meets EU road-homologation requirements while providing solid rider grip.\nDirect bolt-on replacement for the factory EX and SM footpegs.\nAll the footpegs are inter-compatible with all the Stark VARG MX, EX and SM.\"",
          localization_key: "spare_parts_product_titanium-footpegs-pair-road-legal_name",
