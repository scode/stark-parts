    {
      code: "left-rear-wheel-tensioner",
      display_name: "Left rear wheel tensioner",
      localization_key: "spare_parts_product_left-rear-wheel-tensioner_name",
      stark_url: "https://starkfuture.com/parts-and-accessories/product/left-rear-wheel-tensioner",
      image_urls: ["https://assets.starkfuture.com/spare-parts-images/SMX1-RW-S-02M.webp"],
      articles: [
        {
          code: "left-rear-wheel-tensioner",
          display_name: "Left rear wheel tensioner",
          description: "The VARG’s rear axle and swingarm feature two remarkable innovations.\nFirstly, an advanced chain adjuster for precise and accurate chain adjustment. The adjuster block incorporates a spring and shaft, which at every 90 degrees rotation gives you an audible click feedback. Using a hex driver you can easily turn the same number of clicks on each side and perfectly align your wheel with optimal chain tension.\n\nStepping it up another notch we introduced a flush rear axle design that eliminates protruding nuts and bolts that can possibly catch on ruts, dirt or rocks, reducing risk while enhancing your riding experience and handling.\nChain adjuster with clicks enables hassle free adjustment. You no longer need to use two wrenches, simply one hex.\nFlush rear axle nut reduces risk of getting caught in ruts.\n\nThe chain slack must be measured at the end of the chain slider, on top of the swingarm. It must be around 45-50 mm (1.8 - 2.0 inches) for the VARG MX, EX and SM.\n\nLeft side - sold individually.",
          localization_key: "spare_parts_product_left-rear-wheel-tensioner_name",
          description_localization_key: "spare_parts_product_left-rear-wheel-tensioner_description",
          stark_url: "https://starkfuture.com/parts-and-accessories/product/left-rear-wheel-tensioner",
