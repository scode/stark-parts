    {
      code: "front-sprocket-ex-mx-sm",
      display_name: "Front sprocket",
      localization_key: "spare_parts_product_front-sprocket-ex-mx-sm_name",
      stark_url: "https://starkfuture.com/parts-and-accessories/product/front-sprocket-ex-mx-sm",
      image_urls: ["https://assets.starkfuture.com/spare-parts-images/admin/b2ba678e-1596-4437-8ec4-c51941892e20.webp", "https://assets.starkfuture.com/spare-parts-images/SMX1-PT-GB.webp", "https://assets.starkfuture.com/spare-parts-images/admin/10b328b9-7f4b-44ba-a44e-4ede5c530588.webp"],
      articles: [
        {
          code: "front-sprocket-ex-mx-sm",
          display_name: "Front sprocket",
          description: "The Stark-designed front sprocket features a dedicated mud-expelling groove that helps clear excess mud and debris during off-road riding.\nMade from hardened chromoly steel, it is built for the demands of motocross and enduro use.\n\nComputer-optimized for a compact, lightweight design, the sprocket is available in four sizes to tailor the VARG’s gearing to your riding style.\n\nStandard gearing:\n\nVARG MX: 14/47\nVARG EX: 12/48\nVARG SM: 15/47\n\nA 13T option is also available.\n\nImportant: Changing the front sprocket size affects the acceleration/top-speed balance: smaller sprockets provide quicker acceleration, while larger sprockets increase top speed.\nChanging the homologated sprocket size will void the road homologation of the Stark VARG EX or SM.",
          localization_key: "spare_parts_product_front-sprocket-ex-mx-sm_name",
          description_localization_key: "spare_parts_product_front-sprocket-ex-mx-sm_description",
