    {
      code: "grip-seat-jet-black",
      display_name: "Grip seat Jet Black",
      localization_key: "spare_parts_product_grip-seat-jet-black_name",
      stark_url: "https://starkfuture.com/parts-and-accessories/product/grip-seat-jet-black",
