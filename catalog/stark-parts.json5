    {
      code: "kyb-front-fork-leg-right-mx",
      display_name: "KYB Front fork leg right MX",
      localization_key: "spare_parts_product_kyb-front-fork-leg-right-mx_name",
      stark_url: "https://starkfuture.com/parts-and-accessories/product/kyb-front-fork-leg-right-mx",
      image_urls: ["https://assets.starkfuture.com/spare-parts-images/0d938837-1fb0-4bc2-94a8-925ba5ffc331.webp"],
      articles: [
        {
          code: "kyb-front-fork-leg-right-mx",
          display_name: "KYB Front fork leg right MX",
          description: "KYB/Kayaba Technical Touch right front fork leg for the Stark VARG MX, featuring a 48 mm closed-cartridge design with 300 mm of travel and an AOS damping system.\nThe fork features adjustable compression and rebound damping, with lightweight Kashima-coated outer tubes and NiCr-coated inner tubes to minimize friction and maximize wear resistance.\nFeaturing an internal setting optimized for motocross use, this fork leg is compatible with the VARG EX and VARG MX, but not compatible with the VARG SM.\nNote that VARG SM fork feet cannot be installed on this fork leg.\n\nFor faster riders, opt for one setting higher, while amateurs may prefer to go lower.",
          localization_key: "spare_parts_product_kyb-front-fork-leg-right-mx_name",
          description_localization_key: "spare_parts_product_kyb-front-fork-leg-right-mx_description",
