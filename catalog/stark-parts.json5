      articles: [
        {
          code: "grip-seat-jet-black",
          display_name: "Grip seat Jet Black",
          description: "The Stark VARG Grip Seat is designed to keep you firmly in position, combining an asphalt-textured surface with six low-profile rubber ribs (2.6 mm high) for enhanced grip in wet conditions and under hard acceleration.\n\nInstead of traditional stitching, the seat uses ultrasonic welding to bond the materials together without threads. This prevents water absorption while providing a clean finish, reduced weight, and long-lasting durability.\n\nCompatible with all VARG MX 1.0, MX 1.2, EX, and SM models. Available in black only.\n\nWhen the body kit is removed as a single unit, the seat comes off with it.\nThe seat attaches to the subframe using screw STD-SC-0007, located in the center of the rear fender.",
          localization_key: "spare_parts_product_grip-seat-jet-black_name",
          description_localization_key: "spare_parts_product_grip-seat-jet-black_description",
